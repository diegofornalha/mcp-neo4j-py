# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# MCP Server Config
MCP_TRANSPORT=stdio
MCP_LOG_LEVEL=INFO
MCP_NAMESPACE=default

# Memory Config
ENABLE_FULLTEXT_INDEX=true

# Limites de resposta (para evitar respostas MCP muito grandes)
# Máximo de entidades retornadas por query (padrão: 50)
MEMORY_MAX_ENTITIES=50
# Máximo de observações por entidade (padrão: 20)
MEMORY_MAX_OBSERVATIONS=20
